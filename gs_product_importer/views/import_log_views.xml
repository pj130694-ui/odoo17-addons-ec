<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         gs.import.log — List View
    ================================================================ -->
    <record id="view_gs_import_log_list" model="ir.ui.view">
        <field name="name">gs.import.log.list</field>
        <field name="model">gs.import.log</field>
        <field name="arch" type="xml">
            <tree string="Google Sheet Import Logs"
                  decoration-success="state == 'success'"
                  decoration-warning="state == 'partial'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'">
                <header>
                    <button name="action_run_import_now"
                            type="object"
                            string="Run Import Now"
                            class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="run_date"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'running'"
                       decoration-muted="state == 'draft'"/>
                <field name="rows_total"              string="Total"/>
                <field name="rows_created"            string="Created"/>
                <field name="rows_updated"            string="Updated"/>
                <field name="rows_failed"             string="Failed"/>
                <field name="rows_skipped"            string="Skipped"         optional="show"/>
                <field name="rows_archived_variants"  string="Arch.Variants"   optional="show"/>
                <field name="rows_archived_templates" string="Arch.Templates"  optional="show"/>
                <field name="rows_categories_created" string="Cats Created"    optional="show"/>
                <field name="message"                 string="Summary"         optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         gs.import.log — Form View
    ================================================================ -->
    <record id="view_gs_import_log_form" model="ir.ui.view">
        <field name="name">gs.import.log.form</field>
        <field name="model">gs.import.log</field>
        <field name="arch" type="xml">
            <form string="Import Log" create="false" edit="false">
                <header>
                    <button name="action_run_import_now"
                            type="object"
                            string="Run Import Now"
                            class="btn-primary oe_highlight"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,running,success,partial,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Run Information">
                            <field name="run_date" readonly="1"/>
                            <field name="state"    readonly="1"/>
                        </group>
                        <group string="Row Statistics">
                            <field name="rows_total"     readonly="1"/>
                            <field name="rows_processed" readonly="1"/>
                            <field name="rows_created"   readonly="1"/>
                            <field name="rows_updated"   readonly="1"/>
                            <field name="rows_failed"    readonly="1"/>
                            <field name="rows_skipped"   readonly="1"/>
                        </group>
                    </group>

                    <group string="Sync Results">
                        <group>
                            <field name="rows_archived_variants"  readonly="1"/>
                            <field name="rows_archived_templates" readonly="1"/>
                        </group>
                        <group>
                            <field name="rows_categories_created" readonly="1"/>
                        </group>
                    </group>

                    <group string="Summary">
                        <field name="message" readonly="1" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="Row Detail" name="lines">
                            <field name="line_ids" readonly="1">
                                <tree string="Row Log"
                                      decoration-success="state == 'success'"
                                      decoration-warning="state == 'warning'"
                                      decoration-danger="state == 'failed'"
                                      decoration-muted="state == 'skipped'">
                                    <field name="row_number"   string="Row"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-success="state == 'success'"
                                           decoration-warning="state == 'warning'"
                                           decoration-danger="state == 'failed'"
                                           decoration-muted="state == 'skipped'"/>
                                    <field name="product_name" string="Product"/>
                                    <field name="product_ref"  string="Ref"/>
                                    <field name="message"      string="Detail"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Window action
    ================================================================ -->
    <record id="action_gs_import_log" model="ir.actions.act_window">
        <field name="name">Import Logs</field>
        <field name="res_model">gs.import.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No import logs yet.</p>
            <p>Click <strong>Run Import Now</strong> to start your first import.</p>
        </field>
    </record>

    <!-- ================================================================
         Server action (Action menu fallback)
    ================================================================ -->
    <record id="action_server_gs_run_import" model="ir.actions.server">
        <field name="name">Run Google Sheet Import Now</field>
        <field name="model_id" ref="gs_product_importer.model_gs_import_log"/>
        <field name="binding_model_id" ref="gs_product_importer.model_gs_import_log"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">action = model.action_run_import_now()</field>
    </record>

</odoo>
