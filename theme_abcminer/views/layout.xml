<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject Google Fonts for ABCMiner theme -->
    <template id="abcminer_google_fonts" inherit_id="website.layout" name="ABCMiner Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;family=Space+Mono:wght@400;700&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>
</odoo>
