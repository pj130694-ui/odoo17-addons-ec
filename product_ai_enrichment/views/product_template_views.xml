<odoo>

    <record id="view_product_template_form_ai_enrichment" model="ir.ui.view">
        <field name="name">product.template.form.ai.enrichment</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Botón de acción en header (solo productos físicos) -->
            <xpath expr="//header" position="inside">
                <button name="action_enrich_with_ai"
                        string="✨ Enriquecer con IA"
                        type="object"
                        class="btn-secondary"
                        invisible="ai_enrichment_state == 'processing' or type == 'service'"
                        title="Genera descripción e imágenes profesionales automáticamente"/>
            </xpath>

            <!-- Smart button de estado -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_enrichment_log"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-magic"
                        invisible="ai_enrichment_log_count == 0"
                        title="Ver log de enriquecimiento IA">
                    <field name="ai_enrichment_state" widget="badge" string="IA"
                           decoration-success="ai_enrichment_state == 'success'"
                           decoration-warning="ai_enrichment_state in ('pending','processing')"
                           decoration-danger="ai_enrichment_state == 'error'"/>
                </button>
            </xpath>

            <!-- Campo invisible para lógica de visibilidad -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="ai_enrichment_log_count" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>
