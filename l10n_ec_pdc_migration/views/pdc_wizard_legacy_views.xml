<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir sección Legacy a la vista de pdc.wizard -->
    <record id="view_pdc_wizard_legacy_form" model="ir.ui.view">
        <field name="name">pdc.wizard.legacy.form</field>
        <field name="model">pdc.wizard</field>
        <field name="inherit_id" ref="sh_pdc.sh_pdc_payment_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <group string="Información de Migración Odoo 16"
                       invisible="not is_legacy">
                    <group>
                        <field name="legacy_model" readonly="1"/>
                        <field name="legacy_id" readonly="1"/>
                        <field name="legacy_state" readonly="1"/>
                        <field name="is_legacy" readonly="1"/>
                    </group>
                    <group>
                        <field name="legacy_payment_ref" readonly="1"/>
                        <field name="legacy_payment_id" readonly="1"/>
                        <field name="legacy_deposit_move" readonly="1"/>
                        <field name="legacy_done_move" readonly="1"/>
                    </group>
                    <group col="1">
                        <field name="migration_status" readonly="1"/>
                        <field name="migration_note" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Vista lista con filtros de migración -->
    <record id="action_pdc_wizard_legacy" model="ir.actions.act_window">
        <field name="name">PDC Migrados (Histórico Odoo 16)</field>
        <field name="res_model">pdc.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_legacy', '=', True)]</field>
        <field name="context">{'default_is_legacy': True}</field>
    </record>

    <record id="action_pdc_migration_review" model="ir.actions.act_window">
        <field name="name">PDC Migrados - Revisión Manual</field>
        <field name="res_model">pdc.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('migration_status', '=', 'manual_review')]</field>
    </record>
</odoo>
