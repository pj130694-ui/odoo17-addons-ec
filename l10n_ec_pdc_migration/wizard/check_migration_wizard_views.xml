<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_check_migration_wizard_form" model="ir.ui.view">
        <field name="name">check.migration.wizard.form</field>
        <field name="model">check.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente de Migración de Cheques Odoo 16 → 17">
                <sheet>
                    <group string="Conexión Odoo 16">
                        <group>
                            <field name="odoo16_url"/>
                            <field name="odoo16_db"/>
                        </group>
                        <group>
                            <field name="odoo16_user"/>
                            <field name="odoo16_password" password="True"/>
                        </group>
                    </group>
                    <group string="Opciones de Migración">
                        <group>
                            <field name="migrate_customer_checks"/>
                            <field name="migrate_vendor_checks"/>
                            <field name="only_active_checks"/>
                        </group>
                        <group>
                            <field name="dry_run"/>
                            <field name="customer_journal_id"/>
                            <field name="vendor_journal_id"/>
                        </group>
                    </group>
                    <group string="Resultados" invisible="not result_summary">
                        <group string="Clientes">
                            <field name="result_customer_total" readonly="1"/>
                            <field name="result_customer_migrated" readonly="1"/>
                            <field name="result_customer_warning" readonly="1"/>
                            <field name="result_customer_manual" readonly="1"/>
                            <field name="result_customer_skipped" readonly="1"/>
                        </group>
                        <group string="Proveedores">
                            <field name="result_vendor_total" readonly="1"/>
                            <field name="result_vendor_migrated" readonly="1"/>
                            <field name="result_vendor_manual" readonly="1"/>
                        </group>
                        <field name="result_summary" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run_migration" string="Ejecutar Migración"
                            type="object" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_check_migration_wizard" model="ir.actions.act_window">
        <field name="name">Migración Cheques Odoo 16 → 17</field>
        <field name="res_model">check.migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pdc_migration"
              name="Migración Cheques Odoo 16"
              parent="account.menu_finance"
              groups="base.group_system"
              action="action_check_migration_wizard"
              sequence="26"/>

    <menuitem id="menu_pdc_legacy_list"
              name="PDC Históricos (Odoo 16)"
              parent="account.menu_finance"
              groups="account.group_account_invoice"
              action="action_pdc_wizard_legacy"
              sequence="27"/>

    <menuitem id="menu_pdc_manual_review"
              name="PDC - Revisión Manual"
              parent="account.menu_finance"
              groups="account.group_account_invoice"
              action="action_pdc_migration_review"
              sequence="28"/>
</odoo>
