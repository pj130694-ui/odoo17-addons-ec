<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_binance" model="ir.ui.view">
        <field name="name">Binance Pay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'binance'">
                    <field name="binance_api_key"
                           required="code == 'binance' and state != 'disabled'"/>
                    <field name="binance_secret_key" password="True"
                           required="code == 'binance' and state != 'disabled'"/>
                    <field name="binance_settlement_currency"
                           required="code == 'binance' and state != 'disabled'"/>
                    <field name="binance_webhook_url" readonly="1"
                           widget="CopyClipboardChar"/>
                    <button name="action_binance_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'disabled'"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
