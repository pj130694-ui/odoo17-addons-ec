<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_validate_ec_sri_name_wizard_form" model="ir.ui.view">
        <field name="name">validate.ec.sri.name.wizard.form</field>
        <field name="model">validate.ec.sri.name.wizard</field>
        <field name="arch" type="xml">
            <form string="Buscar por Nombre - SRI / RC">
                <sheet>
                    <field name="partner_id" invisible="1"/>
                    <field name="selected_index" invisible="1"/>

                    <group>
                        <field name="name_query"
                               string="Nombre"
                               placeholder="Ej: GARCIA LOPEZ JUAN CARLOS"
                               required="1"/>
                    </group>

                    <group string="Resultado encontrado" invisible="not result_cedula">
                        <field name="result_cedula" string="Cédula / RUC"/>
                        <field name="result_nombre" string="Nombre"/>
                        <field name="result_street" string="Dirección"
                               invisible="not result_street"/>
                        <field name="result_phone" string="Teléfono"
                               invisible="not result_phone"/>
                        <field name="result_email" string="Correo"
                               invisible="not result_email"/>
                        <field name="result_count" invisible="1"/>
                    </group>

                    <group invisible="not result_cedula and result_count == 0">
                        <field name="alt1_cedula" string="Alternativa 1 — Cédula"
                               invisible="not alt1_cedula"/>
                        <field name="alt1_nombre" string="Alternativa 1 — Nombre"
                               invisible="not alt1_cedula"/>
                        <button name="action_select_2" type="object" string="Usar alternativa 1"
                                class="btn-secondary btn-sm"
                                invisible="not alt1_cedula"/>
                        <field name="alt2_cedula" string="Alternativa 2 — Cédula"
                               invisible="not alt2_cedula"/>
                        <field name="alt2_nombre" string="Alternativa 2 — Nombre"
                               invisible="not alt2_cedula"/>
                        <button name="action_select_3" type="object" string="Usar alternativa 2"
                                class="btn-secondary btn-sm"
                                invisible="not alt2_cedula"/>
                        <field name="alt3_cedula" string="Alternativa 3 — Cédula"
                               invisible="not alt3_cedula"/>
                        <field name="alt3_nombre" string="Alternativa 3 — Nombre"
                               invisible="not alt3_cedula"/>
                        <button name="action_select_4" type="object" string="Usar alternativa 3"
                                class="btn-secondary btn-sm"
                                invisible="not alt3_cedula"/>
                        <field name="alt4_cedula" string="Alternativa 4 — Cédula"
                               invisible="not alt4_cedula"/>
                        <field name="alt4_nombre" string="Alternativa 4 — Nombre"
                               invisible="not alt4_cedula"/>
                        <button name="action_select_5" type="object" string="Usar alternativa 4"
                                class="btn-secondary btn-sm"
                                invisible="not alt4_cedula"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_search" string="Buscar" type="object" class="btn-primary"/>
                    <button name="action_apply" string="Aplicar" type="object"
                            class="btn-success" invisible="not result_cedula"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
