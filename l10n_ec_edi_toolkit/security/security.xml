<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Grupo: Herramientas EDI EC - Administrador

            Permite acceso a:
            - Botón "Pasar a Borrador" con validaciones específicas Ecuador
            - Botón "Limpiar Error SRI" para resetear errores de envío

            Se recomienda asignar solo a contadores administradores o al
            administrador técnico de la empresa. No asignar a facturadores
            estándar para evitar acciones inadvertidas sobre comprobantes.

            Hereda de: account.group_account_manager
        -->
        <record id="group_ec_edi_toolkit_manager" model="res.groups">
            <field name="name">Herramientas EDI EC: Administrador</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
            <field name="comment">
                Acceso a herramientas avanzadas de gestión de facturas electrónicas
                ecuatorianas: pasar a borrador con validaciones SRI y limpiar errores
                de envío al SRI. Usar con precaución por su impacto tributario.
            </field>
        </record>
    </data>
</odoo>
